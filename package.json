{
  "name": "lucky-toolkit",
  "version": "4.0.10",
  "private": true,
  "description": "Regression and release checks for Lucky Toolkit",
  "scripts": {
    "test": "node scripts/run-checks.cjs",
    "verify": "npm test && node scripts/release-check.cjs --local",
    "verify:release": "npm run verify && node scripts/release-check.cjs --release"
  },
  "devDependencies": {
    "@codemirror/state": "6.7.1"
  },
  "engines": {
    "node": ">=24"
  }
}
